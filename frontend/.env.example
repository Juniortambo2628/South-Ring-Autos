NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Laravel Reverb websocket server (must match backend REVERB_* values)
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=127.0.0.1
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=https

# Backend origin for images/assets served from backend/public (defaults to same-origin if unset -> 404s)
NEXT_PUBLIC_ASSET_URL=http://127.0.0.1:8000
